// ─────────────────────────────────────────────────────────────────────────────
//  Latte — a light theme, warm paper surfaces under one terracotta accent.
//
//  One of six themes that share every selector and differ only in palette:
//  dusk, carbon, mint, plum, paper. Keep them in step when adding a component.
//
//  PALETTE                                    GEOMETRY
//  bg        #e8e0d5  canvas, wells           radius  3  slots, bars, tracks
//  surface   #f5efe6  panels, menus           radius  5  controls
//  raised    #fffcf7  controls at rest        radius  7  surfaces
//  hovered   #efe7db  controls under cursor   border  1  hairline, never heavier
//  sunken    #fffcf7  inputs, viewports       height 16  controls
//  line      #1f000000  hairline (12% black)
//  line+     #33000000  emphasis (20% black)
//  text      #2b2622    dim #6b6055    faint #a1958a
//  accent    #c2703f    hover #d4854f  press #a85c31   wash #2ec2703f
//
//  ⚠️ Corner radii here read (bottom-left, bottom-right, top-right, top-left) —
//  the reverse of the CSS order. A title bar wants "0 0 r r", a footer "r r 0 0".
//  1.21 keeps the old order for compatibility; 26.1+ turns it the right way round.
//
//  ⚠️ The code editor keeps a dark background, alone in this theme. Its syntax
//  colours are not styleable — StyleManager hands out ColorPattern.WHITE for
//  identifiers and operators — so a light editor renders white text on white.
//
//  An accent is a statement, so it is spent only where the UI has something to
//  say: focus, selection, an on switch, a filled bar. Everything else is grey,
//  and stays out of the way.
// ─────────────────────────────────────────────────────────────────────────────

// ── surfaces ─────────────────────────────────────────────────────────────────
.panel_bg {
  background: sdf(#faf5efe6, 7, 1, #1f000000);
  padding-all: 6;
  gap-all: 5;
}

.preview_bg {
  background: sdf(#e8e0d5, 6, 1, #1f000000);
  padding-all: 4;
}

.configurator_preview_bg {
  background: sdf(#e8e0d5, 6, 1, #1f000000);
  padding-all: 4;
}

// ── type ─────────────────────────────────────────────────────────────────────
text, label {
  text-shadow: false;
  text-color: #2b2622;
  font: ldlib2:jetbrains_mono_bold;
}

// ── button ───────────────────────────────────────────────────────────────────
// Neutral by default. A screen full of accent-coloured buttons reads as a toy;
// the accent is kept for the confirm button, where it means something.
button:host {
  base-background: sdf(#fffcf7, 5, 1, #1f000000);
  hover-background: sdf(#efe7db, 5, 1, #33000000);
  pressed-background: sdf(#e8e0d5, 5, 1, #33000000);
  padding-all: 3;
  height: 16;
}

button:host .__button_text__ {
  text-color: #2b2622;
  text-shadow: false;
}

button:disabled:host {
  base-background: sdf(#f0eae0, 5, 1, #14000000);
}

button:disabled:host .__button_text__ {
  text-color: #a1958a;
  text-shadow: false;
}

.__confirm-button__ {
  base-background: sdf(#c2703f, 5);
  hover-background: sdf(#d4854f, 5);
  pressed-background: sdf(#a85c31, 5);
}

.__confirm-button__ .__button_text__ {
  text-color: #e8e0d5;
}

.__reject-button__ {
  base-background: sdf(#e5484d, 5);
  hover-background: sdf(#ec6165, 5);
  pressed-background: sdf(#cc3d42, 5);
}

.__reject-button__ .__button_text__ {
  text-color: #e8e0d5;
}

// ── text input ───────────────────────────────────────────────────────────────
// ⚠️ Fields draw their own text, so `text, label` never reaches it, and TEXT_COLOR
// defaults to white with CURSOR_COLOR near it. Set without :host on purpose: that
// pseudo matches only elements which are not internal to another component, so a
// colour selector's own fields are outside it — which is how they came out white
// on white. Only the colours are set here; the frame stays with the rules below,
// which are :host so that a component styling its own field keeps control of it.
text-field, text-area {
  text-color: #2b2622;
  cursor-color: #2b2622;
  text-shadow: false;
}

text-field:host,
.__tag-field_text-field__,
.__search-component_text-field__ {
  background: sdf(#fffcf7, 5, 1, #1f000000);
  focus-overlay: sdf(#00000000, 5, 1, #c2703f);
  padding-all: 3;
  font: ldlib2:jetbrains_mono_bold;
}

search-component:host {
  background: sdf(#fffcf7, 5, 1, #1f000000);
  focus-overlay: sdf(#00000000, 5, 1, #c2703f);
  height: 16;
}

// ── switch ───────────────────────────────────────────────────────────────────
switch:host {
  base-background: sdf(#efe7db, 6);
  pressed-background: sdf(#c2703f, 6);
  unmark-background: sdf(#6b6055, 5);
  mark-background: sdf(#e8e0d5, 5);
  height: 12;
  width: 22;
  padding-all: 1;
}

// ── selector ─────────────────────────────────────────────────────────────────
selector:host {
  background: sdf(#fffcf7, 5, 1, #1f000000);
  focus-overlay: sdf(#00000000, 5, 1, #c2703f);
  height: 16;
}

selector:host:hovered {
  background: sdf(#efe7db, 5, 1, #33000000);
}

.__selector_button-icon__ {
  background: sprite(ldlib2:textures/gui/down.png) scale(0.55) color(#6b6055);
}

.__selector_dialog__, .__search-component_dialog__ {
  background: sdf(#fcf5efe6, 7, 1, #33000000);
  padding-all: 3;
}

// ── progress bar ─────────────────────────────────────────────────────────────
progress-bar:host {
  height: 8;
}

progress-bar:host label {
  font-size: 6;
  text-color: #2b2622;
  font: ldlib2:jetbrains_mono_bold;
}

.__progress-bar_bar-container__ {
  background: sdf(#fffcf7, 4, 1, #1f000000);
  padding-all: 0;
}

.__progress-bar_bar__ {
  background: sdf(#c2703f, 4);
  padding-all: 0;
}

// ── slots ────────────────────────────────────────────────────────────────────
item-slot, .item-slot_bg {
  background: sdf(#fffcf7, 4, 1, #1f000000);
  hover-overlay: sdf(#1a000000, 4);
}

fluid-slot, .fluid-slot_bg {
  background: sdf(#fffcf7, 4, 1, #1f000000);
}

// ── colour selector ──────────────────────────────────────────────────────────
color-selector:host text-field {
  background: sdf(#fffcf7, 5, 1, #1f000000);
  focus-overlay: sdf(#00000000, 5, 1, #c2703f);
  padding-all: 3;
  font: ldlib2:jetbrains_mono_bold;
}

color-selector:host button {
  base-background: sdf(#fffcf7, 4, 1, #1f000000);
  hover-background: sdf(#efe7db, 4, 1, #33000000);
  pressed-background: sdf(#e8e0d5, 4, 1, #33000000);
}

color-selector:host .__color-selector_alpha-slider__ {
  background: sdf(#fffcf7, 4, 1, #1f000000);
  margin-right: 3;
  padding-all: 2;
}

color-selector:host .__color-selector_color-slider__ {
  background: sdf(#fffcf7, 4, 1, #1f000000);
  margin-bottom: 3;
  padding-all: 2;
}

color-selector:host .__color-selector_color-preview__ {
  background: sdf(#fffcf7, 4, 1, #1f000000);
  margin-right: 3;
  margin-bottom: 3;
  padding-all: 2;
}

// ── toggle ───────────────────────────────────────────────────────────────────
toggle:host {
  mark-background: sdf(#2ec2703f, 4, 1, #c2703f);
  height: 14;
}

.__toggle_button__ {
  base-background: sdf(#fffcf7, 4, 1, #1f000000);
  hover-background: sdf(#efe7db, 4, 1, #33000000);
  pressed-background: sdf(#e8e0d5, 4, 1, #33000000);
}

toggle:on .__toggle_button__ {
  base-background: sdf(#2ec2703f, 4, 1, #c2703f);
  hover-background: sdf(#44c2703f, 4, 1, #d4854f);
  pressed-background: sdf(#2ea85c31, 4, 1, #c2703f);
}

.__toggle_mark-icon__ {
  margin-all: 2;
  width: auto;
  height: auto;
  flex: 1;
}

// ── text area ────────────────────────────────────────────────────────────────
text-area {
  scroller-view-margin: 8;
  font: ldlib2:jetbrains_mono_bold;
}

text-area:host {
  focus-overlay: sdf(#00000000, 5, 1, #c2703f);
}

// The tree's arrows ship as white sprites, so on a light palette they disappear
// into the row. Re-pointed at the same atlas cells and tinted with the theme.
tree-list {
  collapse-icon: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 188, 240, 5, 5) color(#6b6055);
  expand-icon: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 132, 230, 5, 5) color(#6b6055);
}

.__text-area_content-view__ {
  background: sdf(#fffcf7, 5, 1, #1f000000);
  padding-all: 3;
}

.__text-area_horizontal-scroller__ {
  height: 5;
  margin-top: 2;
}

.__text-area_vertical-scroller__ {
  width: 5;
  margin-left: 2;
}

// ── scrollers ────────────────────────────────────────────────────────────────
// Rail and thumb only. The end buttons are gone: nobody has clicked a scrollbar
// arrow since the mouse wheel, and they cost two chunks of every scroller.
scroller-horizontal:host {
  height: 5;
}

scroller-vertical:host {
  width: 5;
}

.__scroller_scroll_container__ {
  background: sdf(#14000000, 3);
  padding-all: 0;
}

scroller-horizontal .__scroller_scroll_bar__,
scroller-vertical .__scroller_scroll_bar__ {
  base-background: sdf(#40000000, 3);
  hover-background: sdf(#73000000, 3);
  pressed-background: sdf(#c2703f, 3);
}

.__scroller_head_button__, .__scroller_tail_button__ {
  display: none;
}

scroller-view {
  scroller-view-margin: 8;
}

.__scroller_view_view-port__ {
  background: sdf(#fffcf7, 5, 1, #1f000000);
  padding-all: 3;
}

.__scroller_view_horizontal-scroller__ {
  height: 5;
  margin-top: 2;
}

.__scroller_view_vertical-scroller__ {
  width: 5;
  margin-left: 2;
}

// ── slider ───────────────────────────────────────────────────────────────────
slider-horizontal:host {
  height: 10;
}

slider-vertical:host {
  width: 10;
}

slider-horizontal, slider-vertical {
  slider-track-size: 3;
  slider-handle-size: 5;
}

.__slider_track__ {
  background: sdf(#fffcf7, 2, 1, #1f000000);
}

.__slider_fill__ {
  background: sdf(#c2703f, 2);
}

.__slider_handle__ {
  base-background: sdf(#2b2622, 3);
  hover-background: sdf(#c2703f, 3);
  pressed-background: sdf(#a85c31, 3);
}

// ── tabs ─────────────────────────────────────────────────────────────────────
// The header is the same surface as the content, joined by one seam, so a tab
// strip reads as one card rather than as a lid resting on a box.
.__tab-view_tab_header_container__ {
  background: sdf(#fffcf7, 0 0 7 7, 1, #1f000000);
  margin-bottom: -1;
  padding-all: 3;
}

.__tab-view_tab_header_container__ .__scroller_view_view-container__ {
  gap-all: 3;
}

.__tab-view_tab_content_container__ {
  background: sdf(#f5efe6, 7 7 0 0, 1, #1f000000);
}

tab-view .__tab-view_tab_scroller__ {
  margin-bottom: 0;
}

tab:host {
  base-background: empty;
  hover-background: sdf(#1f000000, 5);
  pressed-background: sdf(#2ec2703f, 5);
  padding-all: 3;
  height: 16;
}

tab:host:selected {
  base-background: sdf(#f5efe6, 0 0 5 5);
  hover-background: sdf(#f5efe6, 0 0 5 5);
  pressed-background: sdf(#f5efe6, 0 0 5 5);
}

tab:host:not(tab:selected) label {
  text-color: #6b6055;
  text-shadow: false;
}

// ── dialog ───────────────────────────────────────────────────────────────────
.__dialog_title__ {
  background: sdf(#fffcf7, 0 0 7 7, 1, #33000000);
  transform: translateY(1);
}

.__dialog_title__ > label {
  text-color: #2b2622;
}

.__dialog_content-container__ {
  background: sdf(#fcf5efe6, 0, 1, #33000000);
}

.__dialog_button-container__ {
  background: sdf(#fcf5efe6, 7 7 0 0, 1, #33000000);
  transform: translateY(-1);
}

// ── menu ─────────────────────────────────────────────────────────────────────
menu {
  background: sdf(#fcf5efe6, 6, 1, #33000000);
  arrow: sprite(ldlib2:textures/gui/right.png) scale(0.55) color(#6b6055);
}

// ── editor ───────────────────────────────────────────────────────────────────
.__editor__ code-editor {
  background: sdf(#161a20, 6, 1, #33000000);
}

.__editor_top__ {
  background: sdf(#fffcf7, 0 0 6 6);
}

.__editor__ button:host {
  base-background: sdf(#00000000, 5, 1, #1f000000);
  hover-background: sdf(#1f000000, 5, 1, #33000000);
  pressed-background: sdf(#2ec2703f, 5, 1, #c2703f);
}

.__editor__ tab:host {
  height: 15;
}

.__editor-gizmo-bar__ {
  background: sdf(#faf5efe6, 6, 1, #33000000);
}

.__view-container__ {
  background: sdf(#e8e0d5);
}

.__view-container_tab-view__ .__tab-view_tab_content_container__ {
  padding-all: 3;
}

.__view-container_collapse-button__ {
  height: 14;
  width: 14;
}

ResourceView .__tab-view_tab_header_container__ .__scroller_view_view-container__ {
  gap-all: 2;
}

ResourceView tab:host {
  base-background: empty;
  hover-background: sdf(#1f000000, 5) scale(0.92);
  pressed-background: sdf(#2ec2703f, 5) scale(0.92);
}

ResourceView tab:host:selected {
  base-background: sdf(#f5efe6, 5) scale(0.92);
  hover-background: sdf(#fffcf7, 5) scale(0.92);
  pressed-background: sdf(#fffcf7, 5) scale(0.92);
}

ResourceView .__tab-view_tab_header_container__ {
  background: sdf(#e8e0d5, 7 0 0 7, 1, #1f000000);
  transform: translate(1, 0);
}

ResourceView .__tab-view_tab_content_container__ {
  background: sdf(#f5efe6, 0 7 7 0, 1, #1f000000);
}

.__ui-editor-view_header__ {
  background: sdf(#f5efe6);
}

.__ui-editor-view_header__ button {
  height: 14;
}

.__ui-editor-view_header__ .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1f000000);
  hover-background: sdf(#1f000000, 4, 1, #33000000);
  pressed-background: sdf(#2ec2703f, 4, 1, #c2703f);
}

.__ui-editor-view_canvas__ {
  background: #e2d9cc;
}

.__ui-editor-view_builtin-styles-toggle__ {
  height: 14;
  padding-all: 0;
  mark-background: sdf(#00000000, 4, 1, #c2703f);
}

.__ui-editor-view_builtin-styles-toggle__ .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1f000000);
  hover-background: sdf(#1f000000, 4, 1, #33000000);
}

.__ui-editor-view_builtin-styles-toggle__ .__toggle_mark-icon__ {
  margin-all: 0;
}

.__ui-editor-view_style-view__ {
  background: empty;
  gap-all: 3;
}

.__editor-window_active__ {
  background: #c2703f;
}

.__editor-window_inactive__ {
  background: #fffcf7;
}

// ── configurator ─────────────────────────────────────────────────────────────
.__configurator-group__ .__configurator-group_container__ {
  background: sdf(#f5efe6, 6 6 6 0, 1, #1f000000);
}

.__configurator-group__ > .__configurator_line__ {
  background: sdf(#e8e0d5, 5, 1, #1f000000);
}

.__configurator-group__ > .__configurator_line__:hovered:not(:disabled) {
  background: sdf(#fffcf7, 5, 1, #33000000);
}

.__configurator-group__ > .__configurator_line__ > .__configurator_label__ {
  text-color: #6b6055;
  text-shadow: false;
}

ToggleSelectorConfigurator .__toggle_mark-icon__ {
  margin-all: 0;
}

ToggleSelectorConfigurator .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1f000000);
  hover-background: sdf(#1f000000, 4, 1, #33000000);
  pressed-background: sdf(#2ec2703f, 4, 1, #c2703f);
}

.__array-configurator_button-group__ {
  background: sdf(#00000000, 5, 1, #1f000000);
  padding-all: 2;
}

.__array-configurator_item_selected__ {
  background: sdf(#2ec2703f, 4, 1, #c2703f);
}

// ── node graph ───────────────────────────────────────────────────────────────
.__blackboard-var-prop_title-bar__ {
  background: sdf(#fffcf7, 0 0 6 6, 1, #1f000000);
}

.__blackboard-var-prop_content__ {
  background: sdf(#f5efe6, 6 6 0 0, 1, #1f000000);
}

.__node-graph-view_canvas__ {
  background: #ece5da;
}

.__node-graph-view_canvas-view__ {
  color: #d2c8ba;
}

.__node-element__ {
  background: sdf(#faf5efe6, 6, 1, #33000000);
}

.__node-title-element__ {
  background: sdf(#fffcf7, 0 0 6 6, 1, #1f000000);
  padding-bottom: 4;
}

.__node-port-container__ {
  background: sdf(#00000000, 6 6 0 0);
}

.__in-out-port-container_input__ {
  background: sdf(#00000000);
  margin-all: 1;
}

.__in-out-port-container_output__ {
  background: sdf(#14000000);
  margin-all: 1;
}

.__capsule-node__ {
  background: sdf(#fafffcf7, 8, 1, #33000000);
}

.__capsule-node__ .__node-title-element__ {
  background: empty;
  padding-bottom: 0;
}

.__capsule-node__ .__node-port-container__ {
  background: empty;
}

.__context-node__ > .__node-title-element__ {
  height: 30;
  gap-all: 5;
}

.__block-node__ > .__node-title-element__ {
  background: sdf(#2ec2703f, 0 0 6 6, 1, #c2703f);
}

.__block-list-container__ {
  background: sdf(#fffcf7, 6);
}

.__subgraph-node__ .__node-title-element__ {
  background: sdf(#efe7db, 0 0 6 6, 1, #33000000);
}

.__vertical-port-container__ {
  padding-all: 2;
  gap-all: 4;
}

.__vertical-port__ {
  padding-all: 1;
}

.__node-preview__ {
  background: sdf(#fffcf7, 6 6 0 0, 1, #1f000000);
  padding-all: 3;
}

.__item-library__ {
  background: sdf(#fcf5efe6, 7, 1, #c2703f);
}

.__item-library_description-panel__ {
  background: sdf(#faf5efe6, 7, 1, #1f000000);
  padding-all: 6;
  gap-all: 5;
}
